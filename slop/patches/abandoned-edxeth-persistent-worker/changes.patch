new file mode 100644
index 0000000..a99cb27
--- /dev/null
+++ b/src/runtime/interactive-status.ts
@@ -0,0 +1,30 @@
+import type { SessionEntry } from "../session/session.ts";
+import {
+	INTERACTIVE_TURN_STATUS_ENTRY,
+	type InteractiveTurnStatus,
+} from "../tools/interactive-status.ts";
+
+function isTurnStatus(value: unknown): value is InteractiveTurnStatus {
+	if (!value || typeof value !== "object") return false;
+	const status = value as Partial<InteractiveTurnStatus>;
+	return (
+		status.version === 1 &&
+		typeof status.statusId === "string" &&
+		typeof status.runId === "string" &&
+		typeof status.updatedAt === "string" &&
+		(status.turn === "running" || status.turn === "settled" || status.turn === "error") &&
+		(typeof status.activeSubagents === "number" || status.activeSubagents === "unknown") &&
+		(typeof status.activeProcesses === "number" || status.activeProcesses === "unknown")
+	);
+}
+
+/** Read only valid append-only child turn statuses, ignoring other extension data. */
+export function getInteractiveTurnStatuses(entries: SessionEntry[]): InteractiveTurnStatus[] {
+	const statuses: InteractiveTurnStatus[] = [];
+	for (const entry of entries) {
+		const custom = entry as { type?: unknown; customType?: unknown; data?: unknown };
+		if (custom.type !== "custom" || custom.customType !== INTERACTIVE_TURN_STATUS_ENTRY) continue;
+		if (isTurnStatus(custom.data)) statuses.push(custom.data);
+	}
+	return statuses;
+}
diff --git a/../pi-subagents-visible-worker/src/tools/interactive-status.ts b/src/tools/interactive-status.ts
new file mode 100644
index 0000000..96387f9
--- /dev/null
+++ b/src/tools/interactive-status.ts
@@ -0,0 +1,164 @@
+import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";
+import { acknowledgeInteractiveInboxMessage, readInteractiveInboxMessages } from "../runtime/interactive-inbox.ts";
+import { getPublishedRunningSubagentCountStatus } from "../runtime/nested-lifecycle.ts";
+
+export const INTERACTIVE_TURN_STATUS_ENTRY = "pi-subagents:turn-status:v1";
+export type InteractiveTurnState = "running" | "settled" | "error";
+export type ActiveWorkCount = number | "unknown";
+
+export interface InteractiveTurnStatus {
+	version: 1;
+	statusId: string;
+	runId: string;
+	updatedAt: string;
+	turn: InteractiveTurnState;
+	activeSubagents: ActiveWorkCount;
+	activeProcesses: ActiveWorkCount;
+	lastAssistant?: { entryId?: string; text?: string };
+	error?: string;
+}
+
+type SessionEntry = {
+	id?: unknown;
+	type?: unknown;
+	message?: {
+		role?: unknown;
+		content?: Array<{ type?: unknown; text?: unknown }>;
+		stopReason?: unknown;
+		errorMessage?: unknown;
+	};
+};
+
+type ProcessInfo = { status?: unknown };
+const LIVE_PROCESS_STATUSES = new Set(["running", "terminating", "terminate_timeout"]);
+
+function lastAssistant(ctx: ExtensionContext): { entryId?: string; text?: string; stopReason?: string; error?: string } | undefined {
+	const entries = ctx.sessionManager.getEntries() as SessionEntry[];
+	for (let index = entries.length - 1; index >= 0; index--) {
+		const entry = entries[index];
+		if (entry.type !== "message" || entry.message?.role !== "assistant") continue;
+		const text = (entry.message.content ?? [])
+			.filter((block) => block.type === "text" && typeof block.text === "string")
+			.map((block) => block.text as string)
+			.join("\n")
+			.trim()
+			.slice(0, 2_000);
+		return {
+			...(typeof entry.id === "string" ? { entryId: entry.id } : {}),
+			...(text ? { text } : {}),
+			...(typeof entry.message.stopReason === "string" ? { stopReason: entry.message.stopReason } : {}),
+			...(typeof entry.message.errorMessage === "string" ? { error: entry.message.errorMessage } : {}),
+		};
+	}
+	return undefined;
+}
+
+/** Query pi-processes' documented synchronous list callback when its tool is active. */
+function getActiveProcessCount(pi: Pick<ExtensionAPI, "events" | "getActiveTools">): ActiveWorkCount {
+	if (!pi.getActiveTools().includes("process")) return 0;
+	let replied = false;
+	let processes: unknown;
+	try {
+		pi.events.emit("processes:request:list", {
+			reply(value: unknown) {
+				replied = true;
+				processes = value;
+			},
+		});
+	} catch {
+		return "unknown";
+	}
+	if (!replied || !Array.isArray(processes)) return "unknown";
+	return processes.filter((process) => {
+		const status = (process as ProcessInfo).status;
+		return typeof status === "string" && LIVE_PROCESS_STATUSES.has(status);
+	}).length;
+}
+
+function isQuiet(status: Pick<InteractiveTurnStatus, "turn" | "activeSubagents" | "activeProcesses">): boolean {
+	return status.turn === "settled" && status.activeSubagents === 0 && status.activeProcesses === 0;
+}
+
+/**
+ * Persist turn state and accept bounded inbox items through Pi's own message
+ * API. No terminal editor input is ever used for parent steering.
+ */
+export function installInteractiveTurnStatus(pi: Pick<ExtensionAPI, "appendEntry" | "events" | "getActiveTools" | "on" | "sendUserMessage">): void {
+	if (process.env.PI_SUBAGENT_INTERACTIVE_STATUS !== "1" || !process.env.PI_SUBAGENT_SURFACE) return;
+	const runId = process.env.PI_SUBAGENT_RUN_ID?.trim() || "unknown";
+	const sessionFile = process.env.PI_SUBAGENT_SESSION?.trim();
+	let sequence = 0;
+	let lastStatus: InteractiveTurnStatus | undefined;
+	let latestContext: ExtensionContext | undefined;
+	let quietPoll: ReturnType<typeof setInterval> | undefined;
+
+	const publish = (turn: InteractiveTurnState, ctx: ExtensionContext, error?: string) => {
+		const assistant = lastAssistant(ctx);
+		const activeSubagents = getPublishedRunningSubagentCountStatus();
+		const activeProcesses = getActiveProcessCount(pi);
+		const status: InteractiveTurnStatus = {
+			version: 1,
+			statusId: `${runId}:${Date.now()}:${++sequence}`,
+			updatedAt: new Date().toISOString(),
+			runId,
+			turn,
+			activeSubagents,
+			activeProcesses,
+			...(assistant?.entryId || assistant?.text
+				? { lastAssistant: { ...(assistant.entryId ? { entryId: assistant.entryId } : {}), ...(assistant.text ? { text: assistant.text } : {}) } }
+				: {}),
+			...(error ? { error: error.slice(0, 1_000) } : {}),
+		};
+		lastStatus = status;
+		pi.appendEntry(INTERACTIVE_TURN_STATUS_ENTRY, status);
+		return status;
+	};
+
+	const acceptQueuedMessage = (ctx: ExtensionContext) => {
+		if (!sessionFile || !ctx.isIdle()) return;
+		const queued = readInteractiveInboxMessages(sessionFile, runId)[0];
+		if (!queued) return;
+		try {
+			pi.sendUserMessage(queued.message.text);
+			acknowledgeInteractiveInboxMessage(queued.path);
+		} catch {
+			// Pi did not accept it; retain it for the next idle check.
+		}
+	};
+
+	const updateQuietStatus = () => {
+		if (!latestContext || !lastStatus || lastStatus.turn !== "settled") return;
+		const activeSubagents = getPublishedRunningSubagentCountStatus();
+		const activeProcesses = getActiveProcessCount(pi);
+		if (activeSubagents === lastStatus.activeSubagents && activeProcesses === lastStatus.activeProcesses) {
+			if (isQuiet(lastStatus)) acceptQueuedMessage(latestContext);
+			return;
+		}
+		const status = publish("settled", latestContext);
+		if (isQuiet(status)) acceptQueuedMessage(latestContext);
+	};
+
+	pi.on("agent_start", (_event, ctx) => {
+		latestContext = ctx;
+		publish("running", ctx);
+	});
+	pi.on("agent_settled", (_event, ctx) => {
+		latestContext = ctx;
+		const assistant = lastAssistant(ctx);
+		const status =
+			assistant?.stopReason === "error" || assistant?.stopReason === "aborted"
+				? publish("error", ctx, assistant.error ?? `assistant stopReason: ${assistant.stopReason}`)
+				: publish("settled", ctx);
+		if (isQuiet(status)) acceptQueuedMessage(ctx);
+	});
+	pi.on("session_start", (_event, ctx) => {
+		latestContext = ctx;
+		quietPoll ??= setInterval(updateQuietStatus, 500);
+		quietPoll.unref?.();
+	});
+	pi.on("session_shutdown", () => {
+		if (quietPoll) clearInterval(quietPoll);
+		quietPoll = undefined;
+		latestContext = undefined;
+	});
+}
diff --git a/../pi-subagents-visible-worker/src/tools/subagent-steer.ts b/src/tools/subagent-steer.ts
new file mode 100644
index 0000000..4dc70ce
--- /dev/null
+++ b/src/tools/subagent-steer.ts
@@ -0,0 +1,84 @@
+import type { AgentToolResult, ExtensionAPI } from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import { enqueueInteractiveInboxMessage } from "../runtime/interactive-inbox.ts";
+import { findRunningSubagent } from "../runtime/running-registry.ts";
+
+type SteerToolDetails = {
+	id?: string;
+	name?: string;
+	error?: string;
+	turn?: string;
+	status?: string;
+	delivery?: string;
+};
+
+const SubagentSteerParams = Type.Object({
+	id: Type.String({ description: "Running interactive subagent id or unique display name." }),
+	text: Type.String({ description: "Follow-up text for the settled worker. Multiline text is preserved." }),
+});
+
+/**
+ * Register narrow live steering through the child inbox. The child, not pane
+ * keystrokes, calls Pi's supported sendUserMessage API when it next observes
+ * the queued item.
+ */
+export function registerSubagentSteerTool(
+	pi: ExtensionAPI,
+	shouldRegister: (name: string) => boolean,
+	deps: { enqueue(sessionFile: string, runId: string, text: string): void } = { enqueue: enqueueInteractiveInboxMessage },
+): void {
+	if (!shouldRegister("subagent_steer")) return;
+	pi.registerTool({
+		name: "subagent_steer",
+		label: "Steer Subagent",
+		description: "Queue follow-up text for a reachable opted-in interactive worker after it settles.",
+		promptSnippet: "Queue a safe follow-up for a settled opted-in interactive worker.",
+		promptGuidelines: [
+			"Use subagent_steer only after a quiet settled-turn status; its result confirms queueing, not child execution.",
+		],
+		parameters: SubagentSteerParams,
+		async execute(_toolCallId, params): Promise<AgentToolResult<SteerToolDetails>> {
+			const match = findRunningSubagent(params.id);
+			const running = match.running;
+			if (!running) {
+				return { content: [{ type: "text" as const, text: match.error ?? "Subagent not found." }], details: { error: "not_found" } };
+			}
+			if (running.mode !== "interactive" || !running.interactiveStatus) {
+				return {
+					content: [{ type: "text" as const, text: `Sub-agent "${running.name}" did not opt into live interactive steering.` }],
+					details: { id: running.id, error: "not_opted_in" },
+				};
+			}
+			if (running.turnStatus?.turn !== "settled") {
+				return {
+					content: [{ type: "text" as const, text: `Sub-agent "${running.name}" is not at a settled turn.` }],
+					details: { id: running.id, error: "not_settled", turn: running.turnStatus?.turn ?? "unknown" },
+				};
+			}
+			if (!running.surface) {
+				return {
+					content: [{ type: "text" as const, text: `Sub-agent "${running.name}" has no reachable interactive pane.` }],
+					details: { id: running.id, error: "pane_unreachable" },
+				};
+			}
+			try {
+				deps.enqueue(running.sessionFile, running.id, params.text);
+			} catch (error) {
+				const message = error instanceof Error ? error.message : String(error);
+				return {
+					content: [{ type: "text" as const, text: `Could not queue follow-up for sub-agent "${running.name}": ${message}` }],
+					details: { id: running.id, error: "queue_failed" },
+				};
+			}
+			return {
+				content: [
+					{
+						type: "text" as const,
+						text: `Follow-up queued for sub-agent "${running.name}" (${running.id}). The child has not accepted or executed it yet.`,
+					},
+				],
+				details: { id: running.id, name: running.name, status: "queued", delivery: "pending_child_acceptance" },
+			};
+		},
+	});
+}
diff --git a/../pi-subagents-visible-worker/test/runtime/persistent-interactive-worker.test.ts b/test/runtime/persistent-interactive-worker.test.ts
new file mode 100644
index 0000000..bcb627a
--- /dev/null
+++ b/test/runtime/persistent-interactive-worker.test.ts
@@ -0,0 +1,181 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { assert, afterEach, describe, it, resetSubagentStateForTest, setRunningSubagentForTest } from "../support/index.ts";
+import { enqueueInteractiveInboxMessage, readInteractiveInboxMessages } from "../../src/runtime/interactive-inbox.ts";
+import { publishRunningSubagentCount } from "../../src/runtime/nested-lifecycle.ts";
+import { retainPersistentInteractiveWorkersForReload, takeRetainedPersistentInteractiveWorkers } from "../../src/runtime/state.ts";
+import { wireSubagentSteerBack } from "../../src/runtime/running-registry.ts";
+import { getInteractiveTurnStatuses } from "../../src/runtime/interactive-status.ts";
+import { registerSubagentSteerTool } from "../../src/tools/subagent-steer.ts";
+import { INTERACTIVE_TURN_STATUS_ENTRY, installInteractiveTurnStatus } from "../../src/tools/interactive-status.ts";
+import { assertInteractiveStatusCompatible } from "../../src/launch/prep.ts";
+import { ORCHESTRATOR_ALLOWED_TOOL_NAMES, SUBAGENT_STEER_TOOL_NAME } from "../../src/tools/tool-names.ts";
+
+const settledStatus = {
+	version: 1 as const,
+	statusId: "worker-1:2:1",
+	runId: "worker-1",
+	updatedAt: "2026-09-10T00:00:00.000Z",
+	turn: "settled" as const,
+	activeSubagents: 0,
+	activeProcesses: 0,
+	lastAssistant: { entryId: "answer-1", text: "Worker result" },
+};
+
+describe("persistent interactive worker", () => {
+	afterEach(() => resetSubagentStateForTest());
+
+	it("does not use stale parent context after shutdown aborts a watcher", async () => {
+		const running = {
+			id: "reload-worker", name: "Reload worker", task: "Stay open", mode: "interactive" as const,
+			executionState: "running" as const, deliveryState: "detached" as const, parentClosePolicy: "terminate" as const,
+			startTime: Date.now(), sessionFile: "/tmp/reload-worker.jsonl", allowSteerDelivery: false,
+		};
+		setRunningSubagentForTest(running);
+		let updates = 0;
+		let deliveries = 0;
+		wireSubagentSteerBack({ sendMessage() { deliveries++; } } as any, running, Promise.reject(new Error("Aborted")), () => "0s", () => updates++);
+		await new Promise((resolve) => setTimeout(resolve, 0));
+		assert.equal(updates, 0);
+		assert.equal(deliveries, 0);
+	});
+
+	it("parses only valid append-only turn statuses", () => {
+		assert.deepEqual(
+			getInteractiveTurnStatuses([
+				{ type: "custom", customType: INTERACTIVE_TURN_STATUS_ENTRY, data: settledStatus } as any,
+				{ type: "custom", customType: INTERACTIVE_TURN_STATUS_ENTRY, data: { version: 1 } } as any,
+			]),
+			[settledStatus],
+		);
+	});
+
+	it("reports known zero without a process tool and queries an active process provider", () => {
+		const handlers = new Map<string, Function>();
+		const statuses: any[] = [];
+		const priorEnabled = process.env.PI_SUBAGENT_INTERACTIVE_STATUS;
+		const priorSurface = process.env.PI_SUBAGENT_SURFACE;
+		const priorRunId = process.env.PI_SUBAGENT_RUN_ID;
+		process.env.PI_SUBAGENT_INTERACTIVE_STATUS = "1";
+		process.env.PI_SUBAGENT_SURFACE = "pane:worker";
+		process.env.PI_SUBAGENT_RUN_ID = "worker-1";
+		try {
+			installInteractiveTurnStatus({
+				on(event: string, handler: Function) { handlers.set(event, handler); },
+				appendEntry(_type: string, status: unknown) { statuses.push(status); },
+				getActiveTools: () => [],
+				events: { emit() {} },
+				sendUserMessage() {},
+			} as any);
+			const ctx = { isIdle: () => true, sessionManager: { getEntries: () => [{ type: "message", id: "answer-1", message: { role: "assistant", content: [{ type: "text", text: "Worker result" }], stopReason: "stop" } }] } };
+			handlers.get("agent_start")!({}, ctx);
+			handlers.get("agent_settled")!({}, ctx);
+			assert.equal(statuses[1].activeProcesses, 0);
+
+			const providerHandlers = new Map<string, Function>();
+			const providerStatuses: any[] = [];
+			installInteractiveTurnStatus({
+				on(event: string, handler: Function) { providerHandlers.set(event, handler); },
+				appendEntry(_type: string, status: unknown) { providerStatuses.push(status); },
+				getActiveTools: () => ["process"],
+				events: { emit(_name: string, payload: any) { payload.reply([{ status: "running" }, { status: "exited" }]); } },
+				sendUserMessage() {},
+			} as any);
+			providerHandlers.get("agent_settled")!({}, ctx);
+			assert.equal(providerStatuses[0].activeProcesses, 1);
+
+			const unavailableHandlers = new Map<string, Function>();
+			const unavailableStatuses: any[] = [];
+			installInteractiveTurnStatus({
+				on(event: string, handler: Function) { unavailableHandlers.set(event, handler); },
+				appendEntry(_type: string, status: unknown) { unavailableStatuses.push(status); },
+				getActiveTools: () => ["process"], events: { emit() {} }, sendUserMessage() {},
+			} as any);
+			unavailableHandlers.get("agent_settled")!({}, ctx);
+			assert.equal(unavailableStatuses[0].activeProcesses, "unknown");
+		} finally {
+			if (priorEnabled === undefined) delete process.env.PI_SUBAGENT_INTERACTIVE_STATUS; else process.env.PI_SUBAGENT_INTERACTIVE_STATUS = priorEnabled;
+			if (priorSurface === undefined) delete process.env.PI_SUBAGENT_SURFACE; else process.env.PI_SUBAGENT_SURFACE = priorSurface;
+			if (priorRunId === undefined) delete process.env.PI_SUBAGENT_RUN_ID; else process.env.PI_SUBAGENT_RUN_ID = priorRunId;
+		}
+	});
+
+	it("queues multiline steering without pane input and scopes it to one run", async () => {
+		const directory = mkdtempSync(join(tmpdir(), "pi-subagents-inbox-"));
+		try {
+			const sessionFile = join(directory, "worker.jsonl");
+			const running = {
+				id: "worker-1", name: "Worker", task: "Stay open", mode: "interactive" as const,
+				executionState: "running" as const, deliveryState: "detached" as const, parentClosePolicy: "terminate" as const,
+				startTime: Date.now(), sessionFile, interactiveStatus: true, surface: "pane:worker", turnStatus: settledStatus,
+			};
+			setRunningSubagentForTest(running);
+			const tools = new Map<string, any>();
+			registerSubagentSteerTool({ registerTool(tool: any) { tools.set(tool.name, tool); } } as any, () => true);
+			const result = await tools.get("subagent_steer").execute("call-1", { id: "worker-1", text: "First line\nSecond line" });
+			assert.equal(result.details.delivery, "pending_child_acceptance");
+			assert.deepEqual(readInteractiveInboxMessages(sessionFile, "worker-1").map(({ message }) => message.text), ["First line\nSecond line"]);
+			assert.deepEqual(readInteractiveInboxMessages(sessionFile, "worker-2"), []);
+		} finally {
+			rmSync(directory, { recursive: true, force: true });
+		}
+	});
+
+	it("uses child Pi messaging only after quiet settlement and preserves queued content", async () => {
+		const directory = mkdtempSync(join(tmpdir(), "pi-subagents-inbox-"));
+		const sessionFile = join(directory, "worker.jsonl");
+		const prior = { enabled: process.env.PI_SUBAGENT_INTERACTIVE_STATUS, surface: process.env.PI_SUBAGENT_SURFACE, runId: process.env.PI_SUBAGENT_RUN_ID, session: process.env.PI_SUBAGENT_SESSION };
+		process.env.PI_SUBAGENT_INTERACTIVE_STATUS = "1";
+		process.env.PI_SUBAGENT_SURFACE = "pane:worker";
+		process.env.PI_SUBAGENT_RUN_ID = "worker-1";
+		process.env.PI_SUBAGENT_SESSION = sessionFile;
+		try {
+			publishRunningSubagentCount(() => 0);
+			const handlers = new Map<string, Function>();
+			const sent: string[] = [];
+			installInteractiveTurnStatus({
+				on(event: string, handler: Function) { handlers.set(event, handler); }, appendEntry() {}, getActiveTools: () => [], events: { emit() {} },
+				sendUserMessage(text: string) { sent.push(text); },
+			} as any);
+			const ctx = { isIdle: () => true, sessionManager: { getEntries: () => [] } };
+			handlers.get("agent_settled")!({}, ctx);
+			enqueueInteractiveInboxMessage(sessionFile, "worker-1", "safe\nfollow-up");
+			handlers.get("session_start")!({}, ctx);
+			await new Promise((resolve) => setTimeout(resolve, 550));
+			assert.deepEqual(sent, ["safe\nfollow-up"]);
+			assert.equal(readInteractiveInboxMessages(sessionFile, "worker-1").length, 0);
+			handlers.get("session_shutdown")!({}, ctx);
+		} finally {
+			for (const [key, value] of Object.entries(prior)) {
+				const envKey = key === "enabled" ? "PI_SUBAGENT_INTERACTIVE_STATUS" : key === "surface" ? "PI_SUBAGENT_SURFACE" : key === "runId" ? "PI_SUBAGENT_RUN_ID" : "PI_SUBAGENT_SESSION";
+				if (value === undefined) delete process.env[envKey]; else process.env[envKey] = value;
+			}
+			rmSync(directory, { recursive: true, force: true });
+		}
+	});
+
+	it("retains only opted-in interactive workers for same-process reload", () => {
+		setRunningSubagentForTest({ id: "persistent", name: "Persistent", task: "wait", mode: "interactive", executionState: "running", deliveryState: "detached", parentClosePolicy: "terminate", startTime: Date.now(), sessionFile: "/tmp/persistent.jsonl", interactiveStatus: true });
+		setRunningSubagentForTest({ id: "ordinary", name: "Ordinary", task: "wait", mode: "interactive", executionState: "running", deliveryState: "detached", parentClosePolicy: "terminate", startTime: Date.now(), sessionFile: "/tmp/ordinary.jsonl" });
+		retainPersistentInteractiveWorkersForReload();
+		assert.deepEqual(takeRetainedPersistentInteractiveWorkers().map((running) => running.id), ["persistent"]);
+		assert.deepEqual(takeRetainedPersistentInteractiveWorkers(), []);
+	});
+
+	it("rejects incompatible interactive-status launch and resume shapes", () => {
+		assert.doesNotThrow(() => assertInteractiveStatusCompatible("worker", true, "interactive", false));
+		assert.throws(
+			() => assertInteractiveStatusCompatible("worker", true, "background", false),
+			/mode: interactive and auto-exit: false/,
+		);
+		assert.throws(
+			() => assertInteractiveStatusCompatible("worker", true, "interactive", true),
+			/mode: interactive and auto-exit: false/,
+		);
+	});
+
+	it("allows steering in orchestrator mode", () => {
+		assert.equal(ORCHESTRATOR_ALLOWED_TOOL_NAMES.has(SUBAGENT_STEER_TOOL_NAME), true);
+	});
+});
