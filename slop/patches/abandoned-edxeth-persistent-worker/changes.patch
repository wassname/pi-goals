diff --git a/../pi-subagents-visible-worker/src/runtime/interactive-inbox.ts b/src/runtime/interactive-inbox.ts
new file mode 100644
index 0000000..236e72a
--- /dev/null
+++ b/src/runtime/interactive-inbox.ts
@@ -0,0 +1,65 @@
+import { mkdirSync, readdirSync, readFileSync, renameSync, rmSync, writeFileSync } from "node:fs";
+import { basename, dirname, join } from "node:path";
+
+export interface InteractiveInboxMessage {
+	version: 1;
+	runId: string;
+	messageId: string;
+	text: string;
+}
+
+function inboxDirectory(sessionFile: string, runId: string): string {
+	return join(dirname(sessionFile), `.${basename(sessionFile)}.interactive-inbox`, runId);
+}
+
+/** Queue one parent follow-up for exactly one live child run. */
+export function enqueueInteractiveInboxMessage(sessionFile: string, runId: string, text: string): InteractiveInboxMessage {
+	const directory = inboxDirectory(sessionFile, runId);
+	mkdirSync(directory, { recursive: true, mode: 0o700 });
+	const message: InteractiveInboxMessage = {
+		version: 1,
+		runId,
+		messageId: `${Date.now().toString(36)}-${Math.random().toString(16).slice(2)}`,
+		text,
+	};
+	const destination = join(directory, `${message.messageId}.json`);
+	const temporary = `${destination}.${process.pid}.tmp`;
+	writeFileSync(temporary, JSON.stringify(message), { encoding: "utf8", mode: 0o600, flag: "wx" });
+	renameSync(temporary, destination);
+	return message;
+}
+
+function isInteractiveInboxMessage(value: unknown, runId: string): value is InteractiveInboxMessage {
+	if (!value || typeof value !== "object") return false;
+	const message = value as Partial<InteractiveInboxMessage>;
+	return message.version === 1 && message.runId === runId && typeof message.messageId === "string" && typeof message.text === "string";
+}
+
+/** Read queued messages without deleting them; callers delete only after Pi accepts delivery. */
+export function readInteractiveInboxMessages(sessionFile: string, runId: string): Array<{ path: string; message: InteractiveInboxMessage }> {
+	const directory = inboxDirectory(sessionFile, runId);
+	try {
+		return readdirSync(directory)
+			.filter((name) => name.endsWith(".json"))
+			.sort()
+			.flatMap((name) => {
+				const path = join(directory, name);
+				try {
+					const message = JSON.parse(readFileSync(path, "utf8"));
+					return isInteractiveInboxMessage(message, runId) ? [{ path, message }] : [];
+				} catch {
+					return [];
+				}
+			});
+	} catch {
+		return [];
+	}
+}
+
+export function acknowledgeInteractiveInboxMessage(path: string): void {
+	rmSync(path, { force: true });
+}
+
+export function clearInteractiveInbox(sessionFile: string, runId: string): void {
+	rmSync(inboxDirectory(sessionFile, runId), { recursive: true, force: true });
+}
