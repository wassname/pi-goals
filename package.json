{
  "name": "@wassname2/pi-goals",
  "version": "0.4.0",
  "description": "One agent, one approved goals file, a scheduled loop that re-sends your loop statement and goals, and an optional read-only judge.",
  "author": "wassname",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wassname/pi-goals.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "plan",
    "goal",
    "proof",
    "uat",
    "evidence",
    "judge"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "dependencies": {
    "@jl1990/pi-scheduler": "0.5.1",
    "mdast-util-from-markdown": "^2.1.0",
    "pi-subagents": "0.84.0"
  },
  "bundleDependencies": [
    "@jl1990/pi-scheduler"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "test": "vitest run --dir test",
    "test:watch": "vitest --dir test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "pi": {
    "extensions": [
      "./src/index.ts",
      "./node_modules/@jl1990/pi-scheduler/extensions/scheduler/index.ts"
    ],
    "image": "https://cdn.jsdelivr.net/gh/wassname/pi-goals@main/media/screenshot.png"
  }
}
