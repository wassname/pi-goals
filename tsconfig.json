{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "paths": {
      "pi-intercom": ["./src/intercom-package.d.ts"],
      "@sting8k/pi-vcc/src/core/summarize": ["./src/vcc-package.d.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
